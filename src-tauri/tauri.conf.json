{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bitácora",
  "version": "0.1.0",
  "identifier": "com.tomasquinteros.bitacora",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "popover",
        "title": "Bitácora",
        "width": 460,
        "height": 720,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": true,
        "dragDropEnabled": false
      },
      {
        "label": "main",
        "title": "Bitácora",
        "width": 1180,
        "height": 760,
        "minWidth": 820,
        "minHeight": 560,
        "center": true,
        "visible": false,
        "dragDropEnabled": false
      },
      {
        "label": "quick",
        "title": "Nueva tarea",
        "width": 640,
        "height": 170,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
