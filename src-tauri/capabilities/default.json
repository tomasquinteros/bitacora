{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permisos de las ventanas de la app",
  "windows": [
    "popover",
    "main",
    "quick"
  ],
  "permissions": [
    "core:default",
